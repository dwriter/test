cepted?`Temp HP ${r.before}→${r.after}`:`Kept ${r.before}; ${amt} was lower`);state.modal=null;render();return}
  if(action==='roll-expression'){try{state.modal.result=rollExpression(document.querySelector('#m-expression').value);render()}catch(err){toast(err.message)}return}
  if(action==='roll-attack-damage'){const p=state.modal.damagePayload;const r=rollDamage(p.damageDice,p.damageModifier,p.critical);openModal('roll',{title:p.critical?'Critical Damage':'Damage',total:r.total,detail:`${r.detail.flatMap(x=>x.rolls).join(', ')} ${p.damageModifier?formatSigned(p.damageModifier):''} ${p.damageType}`});addLog(state.active,p.critical?'Critical Damage':'Damage Roll',`${r.total} ${p.damageType}`);persist();return}
}

async function attackRoll(index){const a=attacks(state.active)[index];const rule=advantageState(state.active,'attack');const r=rollD20(rule.mode);const total=r.kept+a.attackBonus;const crit=r.natural===20;const nat1=r.natural===1;let detail=`${r.rolls.join(' / ')} ${formatSigned(a.attackBonus)} · ${rule.mode}`;if(crit)detail+=' · CRITICAL HIT';if(nat1)detail+=' · AUTOMATIC MISS';addLog(state.active,`${a.name} Attack`,`${total}${crit?' CRIT':''}${nat1?' NAT 1':''}`);await persist();openModal('roll',{title:`${a.name} Attack`,total,detail,damagePayload:nat1?null:{...a,critical:crit}})}
function showBreakdown(key){if(key==='ac'){const r=armorClass(state.active);openModal('breakdown',{title:'Armor Class',parts:r.breakdown,value:r.value});return}if(key.startsWith('ability:')){const a=key.split(':')[1];const score=effectiveAbilityScore(state.active,a);const parts=[{label:'Effective score',value:score},{label:'Modifier formula floor((score−10)/2)',value:abilityModifier(score)}];openModal('breakdown',{title:`${a.toUpperCase()} breakdown`,parts,value:abilityModifier(score),signed:true})}}
async function toggleCondition(id){const c=state.active;pushUndo(c,'Condition');const i=c.conditions.findIndex(x=>x.id===id);if(i>=0){c.conditions.splice(i,1);addLog(c,'Condition removed',id)}else{c.conditions.push({id,name:id[0].toUpperCase()+id.slice(1),source:'manual',startedAt:new Date().toISOString()});addLog(c,'Condition added',id)}await persist();state.modal={type:'conditions'};render()}
async function useSecondWind(){const res=state.active.resources.find(r=>r.id==='second-wind');if(!res?.current)return;await mutate('Second Wind',c=>{const rr=c.resources.find(r=>r.id==='second-wind');rr.current--;const amount=rollDie(10)+totalLevel(c);const heal=applyHealing(c,amount);return {amount,heal}},r=>`Rolled ${r.amount}; HP ${r.heal.before}→${r.heal.after}`)}
async function shortRest(){const hd=state.active.health.hitDice.d10;if(!hd.remaining)return toast('No Hit Dice remaining');await mutate('Short Rest',c=>{const die=c.health.hitDice.d10;die.remaining--;const amount=Math.max(0,rollDie(10)+getAbilityModifier(c,'con'));const heal=applyHealing(c,amount);const sw=c.resources.find(r=>r.id==='second-wind');if(sw)sw.current=sw.maximum;return {amount,heal}},r=>`Spent 1d10; healed ${r.heal.amount}; Second Wind restored`)}
async function longRest(){await mutate('Long Rest',c=>{const before=c.health.currentHP;c.health.currentHP=maxHP(c);c.health.temporaryHP=0;const hd=c.health.hitDice.d10;const recover=Math.max(1,Math.floor(hd.maximum/2));hd.remaining=Math.min(hd.maximum,hd.remaining+recover);for(const r of c.resources||[])if((r.recovery||[]).includes('longRest'))r.current=r.maximum;return {before,after:c.health.currentHP,recover}},r=>`HP ${r.before}→${r.after}; recovered ${r.recover} Hit Die`)}

importInput.addEventListener('change',async()=>{const f=importInput.files?.[0];if(!f)return;try{const c=await importCharacterFile(f);c.meta.id=crypto.randomUUID();await saveCharacter(c);await refreshCharacters();state.screen='characters';render();toast('Imported')}catch(e){toast(e.message)}finally{importInput.value=''}});

if('serviceWorker' in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('./service-worker.js').catch(()=>{}));
await refreshCharacters();render();

})();
