racter(state.active); if(msg)toast(msg);}
async function mutate(label,fn,detailFn){pushUndo(state.active,label); const result=fn(state.active); addLog(state.active,label,detailFn?detailFn(result):''); await persist(); render(); return result;}
async function undo(){const c=state.active;const u=c?.history?.undoStack?.pop();if(!u)return toast('Nothing to undo');Object.assign(c,deep(u.before));addLog(c,`Undo: ${u.label}`);await persist('Undone');render();}
function shell(content,nav=true){return `<div class="app-shell"><header class="topbar"><h1>${state.active?esc(state.active.identity.name):'D&D 5e 2014 Player'}</h1><div>${state.active?`<button class="compact ghost" data-act="home">Characters</button>`:''}</div></header><main class="content">${content}</main>${nav&&state.active?bottomNav():''}</div>${state.modal?renderModal():''}`}
function bottomNav(){return `<nav class="bottomnav"><button data-screen="sheet" class="${state.screen==='sheet'?'active':''}">Sheet</button><button data-screen="session" class="${state.screen==='session'?'active':''}">Session</button><button data-screen="combat" class="${state.screen==='combat'?'active':''}">Combat</button><button data-screen="more" class="${state.screen==='more'?'active':''}">More</button></nav>`}

async function refreshCharacters(){state.characters=await listCharacters();}
async function openCharacter(id){state.active=await getCharacter(id); state.screen='sheet'; render();}

function charactersScreen(){
  const cards=state.characters.map(c=>`<section class="card character-card"><div class="between row"><div><h2>${esc(c.identity.name)}</h2><div class="muted">${esc(c.identity.raceName||'Human')} · Fighter ${totalLevel(c)}</div></div><div class="stat"><small>HP</small><div>${c.health.currentHP}/${maxHP(c)}</div></div></div><div class="row" style="margin-top:12px;flex-wrap:wrap"><button class="primary" data-open="${c.meta.id}">Continue</button><button class="compact" data-dup="${c.meta.id}">Duplicate</button><button class="compact" data-exp="${c.meta.id}">Export</button><button class="compact danger" data-del="${c.meta.id}">Delete</button></div></section>`).join('');
  return shell(`<section class="card hero"><h2>My Characters</h2><p class="muted">Offline core build for D&D 5e rules from 2014. This build implements a fully usable Fighter 1 vertical slice.</p><button class="primary wide" data-act="create">＋ Create Fighter</button><button class="wide ghost" style="margin-top:8px" data-act="import">↓ Import Character</button></section>${cards||'<div class="empty">No characters yet. Create your first one.</div>'}`,false);
}

function creatorScreen(){
  const skills=FIGHTER_SKILLS.map(s=>`<label class="check"><input type="checkbox" name="skill" value="${s}"> ${SKILL_LABELS[s]}</label>`).join('');
  return shell(`<section class="card"><h2>Create Character</h2><p class="notice muted">Core v1 creates a level-1 standard Human Fighter. All visible choices below are saved and mechanically applied.</p><label>Character name</label><input id="c-name" placeholder="Aric"><label>Player name</label><input id="c-player" placeholder="Optional"><label>Ability generation</label><select id="c-method"><option value="standard">Standard Array</option><option value="pointBuy">Point Buy (27)</option><option value="manual">Manual</option><option value="roll">Roll 4d6, drop lowest</option></select><div id="ability-editor">${abilityEditor({str:15,dex:14,con:13,int:12,wis:10,cha:8})}</div><label>Choose exactly 2 Fighter skills</label><div class="checkboxes">${skills}</div><label>Armor</label><select id="c-armor"><option value="chain">Chain Mail (AC 16, Str 13)</option><option value="leather">Leather Armor (11 + DEX)</option></select><label>Main weapon</label><select id="c-weapon"><option value="longsword">Longsword</option><option value="rapier">Rapier</option><option value="greatsword">Greatsword</option><option value="longbow">Longbow</option></select><label class="check"><input id="c-shield" type="checkbox" checked> Equip shield (+2 AC)</label><div id="creator-errors" class="error"></div><div class="row" style="margin-top:16px"><button data-act="cancel-create">Cancel</button><button class="primary" data-act="finish-create">Create Character</button></div></section>`,false);
}
function abilityEditor(scores){return `<div class="ability-grid">${ABILITIES.map(a=>`<div><label>${a.toUpperCase()}</label><input class="ability-input" data-ability="${a}" type="number" min="3" max="20" value="${scores[a]}"></div>`).join('')}</div><p class="muted tiny">Standard Human adds +1 to all six scores after these base values.</p>`}

function hpCard(c){const max=maxHP(c),pct=max?Math.max(0,Math.min(100,c.health.currentHP/max*100)):0;return `<section class="card hero"><div class="grid3"><div class="stat"><small>HP</small><div class="big">${c.health.currentHP}</div><small>/ ${max}</small></div><div class="stat"><small>Temp HP</small><div class="big">${c.health.temporaryHP||0}</div></div><div class="stat"><small>AC</small><div class="big">${armorClass(c).value}</div></div></div><div class="hpbar"><div style="width:${pct}%"></div></div><div class="grid3" style="margin-top:10px"><div class="stat"><small>Speed</small><div>${speed(c)} ft</div></div><div class="stat"><small>Initiative</small><div>${formatSigned(initiative(c))}</div></div><div class="stat"><small>Prof.</small><div>${formatSigned(getProficiencyBonus(c))}</div></div></div></section>`}
function conditionPills(c){return (c.conditions||[]).length?c.conditions.map(x=>`<span class="pill bad">${esc(x.name||x.id)}</span>`).join(''):'<span class="muted">None</span>'}
function sheetScreen(){const c=state.active; const abs=ABILITIES.map(a=>{const sc=effectiveAbilityScore(c,a),m=getAbilityModifier(c,a);return `<button class="ability" data-breakdown="ability:${a}"><div class="tiny">${a.toUpperCase()}</div><div class="score">${sc}</div><div class="mod">${formatSigned(m)}</div></button>`}).join(''); const saves=ABILITIES.map(a=>`<div class="skillrow"><span>${c.proficiencies.savingThrows.includes(a)?'●':'○'} ${a.toUpperCase()}</span><button class="compact" data-save="${a}">${formatSigned(saveModifier(c,a))}</button></div>`).join('');const skills=Object.keys(SKILLS).map(s=>`<div class="skillrow"><span>${c.proficiencies.skills[s]?'●':'○'} ${SKILL_LABELS[s]}</span><button class="compact" data-skill="${s}">${formatSigned(skillModifier(c,s))}</button></div>`).join('');return shell(`${hpCard(c)}<section class="card"><div class="between row"><div><h2 sty