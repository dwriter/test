le="margin:0">${esc(c.identity.name)}</h2><div class="muted">Human · Fighter ${totalLevel(c)}</div></div><button data-breakdown="ac" class="compact">AC breakdown</button></div><div class="section-title">Abilities</div><div class="ability-grid">${abs}</div><div class="section-title">Saving Throws</div>${saves}<div class="section-title">Skills</div><div class="between row"><span>Passive Perception</span><strong>${passivePerception(c)}</strong></div>${skills}</section><section class="card"><div class="section-title" style="margin-top:0">Conditions</div>${conditionPills(c)}<div style="margin-top:10px"><button data-act="conditions">Manage Conditions</button></div></section>`)}

function sessionScreen(){const c=state.active;const res=c.resources?.find(r=>r.id==='second-wind');const logs=(c.history?.entries||[]).slice(0,8).map(x=>`<div class="logrow"><span><strong>${esc(x.label)}</strong><br><small class="muted">${esc(x.detail)}</small></span><small>${fmtTime(x.at)}</small></div>`).join('');return shell(`${hpCard(c)}<section class="card"><h3>Quick actions</h3><div class="sheet-actions"><button class="primary" data-act="damage">Damage</button><button data-act="heal">Heal</button><button data-act="temp-hp">Temp HP</button><button data-act="dice">Dice</button><button data-act="initiative">Initiative</button><button data-act="short-rest">Short Rest</button><button data-act="long-rest">Long Rest</button><button data-act="conditions">Condition</button></div></section><section class="card"><div class="between row"><h3 style="margin:0">Resources</h3><button class="compact" data-act="undo">Undo</button></div><div class="skillrow"><span>Second Wind<br><small class="muted">Bonus Action · 1d10 + Fighter level</small></span><button data-act="second-wind" ${!res?.current?'disabled':''}>${res?.current||0}/${res?.maximum||1} Use</button></div></section><section class="card"><h3>Conditions</h3>${conditionPills(c)}</section><section class="card"><h3>Recent actions</h3>${logs||'<span class="muted">No actions yet.</span>'}</section>`)}

function combatScreen(){const c=state.active;const ats=attacks(c).map((a,i)=>`<div class="attackrow"><div><strong>${esc(a.name)}</strong><br><small class="muted">${formatSigned(a.attackBonus)} to hit · ${a.damageDice}${a.damageModifier?formatSigned(a.damageModifier):''} ${a.damageType}</small></div><button class="primary" data-attack="${i}">Attack</button></div>`).join('');return shell(`${hpCard(c)}<section class="card"><h2>Combat</h2><div class="section-title">Attacks</div>${ats||'<span class="muted">No equipped weapons.</span>'}</section><section class="card"><div class="section-title" style="margin-top:0">State</div><div>Conditions: ${conditionPills(c)}</div><div style="margin-top:10px">Concentration: <strong>${c.concentration?.active?'Active':'—'}</strong></div></section>`)}

function moreScreen(){const c=state.active;return shell(`<section class="card"><h2>Character tools</h2><button class="wide" data-act="dice">Dice Roller</button><button class="wide" style="margin-top:8px" data-act="export-active">Export JSON</button><button class="wide" style="margin-top:8px" data-act="undo">Undo last change</button></section><section class="card"><h3>About this build</h3><p class="muted">Implemented: Human Fighter 1 creator, derived stats, AC, skills/saves, attacks, advantage/disadvantage from Poisoned, HP/Temp HP, Second Wind, rests, conditions, dice, action log, undo, IndexedDB autosave, JSON import/export, offline PWA.</p><p class="muted">Not yet exposed in UI: spellcasting, multiclass, level-up, full SRD reference/content packs, complete equipment catalog and every condition's mechanical automation.</p><div class="tiny muted">Rules edition: ${esc(c.meta.rulesEdition)} · Save schema: ${c.meta.schemaVersion}</div></section>`)}

function renderModal(){const m=state.modal;if(!m)return'';let body='';if(m.type==='damage')body=`<h2>Receive Damage</h2><label>Amount</label><input id="m-amount" type="number" min="0" value="1"><label>Damage type</label><select id="m-type">${['acid','bludgeoning','cold','fire','force','lightning','necrotic','piercing','poison','psychic','radiant','slashing','thunder','untyped'].map(x=>`<option>${x}</option>`).join('')}</select><button class="primary wide" data-modal-act="apply-damage">Apply</button>`;
else if(m.type==='heal')body=`<h2>Healing</h2><label>Amount</label><input id="m-amount" type="number" min="0" value="1"><button class="primary wide" data-modal-act="apply-heal">Heal</button>`;
else if(m.type==='temp')body=`<h2>Temporary HP</h2><label>New temporary HP</label><input id="m-amount" type="number" min="0" value="1"><p class="muted">Temporary HP do not stack; a lower value will not replace a higher one.</p><button class="primary wide" data-modal-act="apply-temp">Apply</button>`;
else if(m.type==='dice')body=`<h2>Dice Roller</h2><label>Expression</label><input id="m-expression" value="1d20+5"><button class="primary wide" data-modal-act="roll-expression">Roll</button>${m.result?`<div class="dice-result">${m.result.total}</div><div class="muted">${esc(m.result.detail.map(t=>t.type==='dice'?`${t.rolls.join(', ')}`:`${t.value>=0?'+':''}${t.value}`).join(' · '))}</div>`:''}`;
else if(m.type==='roll')body=`<h2>${esc(m.title)}</h2><div class="dice-result">${m.total}</div><div class="muted">${esc(m.detail||'')}</div>${m.damagePayload?`<button class="primary wide" data-modal-act="roll-attack-damage">Roll Damage</button>`:''}`;
else if(m.type==='conditions')body=`<h2>Conditions</h2>${['blinded','charmed','deafened','frightened','grappled','incapacitated','invisible','paralyzed','petrified','poisoned','prone','restrained','stunned','unconscious'].map(x=>{const on=state.active.conditions.some(c=>c.id===x);return `<div class="skillrow"><span>${x[0].toUpperCase()+x.slice(1)}</span><button data-condition="${x}" class="${on?'danger':''}">${on?'Remove':'Add'}</button></div>`}).join('')}`;
else if(m.type==='breakdown')body=`<h2>${esc(m.title)}</h2>${m.parts.map(p=>`<div class="skillrow"><span>${esc(p.label)}</span><strong>${p.value>=0&&m.signed?'+':''}${p.value}</strong></div>`).join('')}<div class="skillrow"><strong>Total</strong><strong>${m.value}</strong></div>`;
else if(m.type==='confirm')body=`<h2>${esc(m.title)}</h2><p class="muted">${esc(m.message)}</p><div class="row"><button data-modal-act="cancel">Cancel</button><button class="danger" data-modal-act="confirm">Confirm</button></div>`;
return `<div class="modalback" data-modal-act="backdrop"><div class="moda